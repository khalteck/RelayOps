{
  "name": "relayops",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant incident management for distributed product teams.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --filter @relayops/backend --filter @relayops/frontend dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm --filter @relayops/types build && pnpm --filter @relayops/ui build && pnpm -r --if-present test",
    "typecheck": "pnpm --filter @relayops/types build && pnpm --filter @relayops/ui build && pnpm -r --if-present typecheck",
    "seed": "pnpm --filter @relayops/backend seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
